<script>
  // Respect reduced motion: hold the looping trailer on its poster frame
  if (matchMedia('(prefers-reduced-motion: reduce)').matches) {
    document.querySelectorAll<HTMLVideoElement>('.hband__media').forEach((v) => { v.removeAttribute('autoplay'); v.pause(); });
  }
</script>

<script>
  // Contact form: with no form service set in site.json, open the visitor's email app with the message filled in
  document.querySelectorAll<HTMLFormElement>('[data-contact-form]').forEach((form) => {
    if (form.getAttribute('action')) return;
    const note = form.querySelector<HTMLElement>('[data-contact-note]');
    form.addEventListener('submit', (e) => {
      e.preventDefault();
      if (!form.reportValidity()) return;
      const data = new FormData(form);
      const topic = String(data.get('topic') || 'Hello');
      const name = String(data.get('name') || '');
      const subject = `${topic} from ${name}`.trim();
      const body = `${data.get('message') || ''}\n\n${name}\n${data.get('email') || ''}`;
      window.location.href = `mailto:${form.dataset.email}?subject=${encodeURIComponent(subject)}&body=${encodeURIComponent(body)}`;
      if (note) note.textContent = 'Your email app should open now. Press send there and we will get it.';
    });
  });
</script>
