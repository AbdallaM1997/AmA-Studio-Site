---
import { url } from '../lib/url';
import Logo from './Logo.astro';
import Icon from './Icon.astro';
import Checker from './Checker.astro';
import site from '../data/site.json';

const socials = site.socials.filter((s) => s.url);
const socialIcon = (label: string) => label.toLowerCase().replace(/[^a-z]/g, '');
const year = new Date().getFullYear();
const sloganWords = site.slogan.replace(/\.$/, '').split(/\s+/);

const cols = [
  { title: 'Studio', links: [
    { label: 'Games', href: '/games/', icon: 'games' },
    { label: 'About', href: '/#studio', icon: 'studio' },
    { label: 'News', href: '/news/', icon: 'news' },
    { label: 'Contact', href: '/#contact', icon: 'mail' },
  ] },
  { title: 'Players', links: [
    { label: 'Support', href: '/support/', icon: 'support' },
    { label: 'Privacy policy', href: '/privacy/', icon: 'privacy' },
    { label: 'Delete your data', href: '/delete-data/', icon: 'trash' },
    { label: 'Terms of use', href: '/terms/', icon: 'terms' },
  ] },
];
---
<!-- The slogan follows light/dark mode; the columns below are red and yellow in both modes -->
<footer class="footer red">
  <Checker pattern="k2yck3yck2yk" height="36px" />

  <!-- Giant slogan, sized to the full width; words rise in one by one -->
  <div class="footer__mark" aria-hidden="true">
    <p class="display footer__big" data-reveal style={`--d:${(sloganWords.length * 0.08 + 0.1).toFixed(2)}s`}>
      {sloganWords.map((w, i) => <>{i > 0 && ' '}<span class="fw"><span style={`--i:${i}`}>{w}</span>{i === sloganWords.length - 1 && <span class="dot">.</span>}</span></>)}
    </p>
  </div>

  <!-- Edge-to-edge columns: a yellow brand block, then link columns -->
  <div class="footer__cols" data-stagger="0.08">
    <div class="footer__col footer__brand yellow" data-reveal>
      <span class="sq sq--red footer__spark" aria-hidden="true"></span>
      <a href={url('/')} aria-label={`${site.name} home`} class="footer__logo"><Logo size="64px" align="start" /></a>
      <p class="footer__line"><Icon name="pin" /> Made in {site.location}.</p>
      <a href={`mailto:${site.email}`} class="footer__line footer__email"><Icon name="mail" /> {site.email}</a>
      {socials.length > 0 && (
        <ul class="footer__social" aria-label="Follow us">
          {socials.map((s) => (
            <li><a href={s.url} rel="noopener" target="_blank" aria-label={s.label} title={s.label}><Icon name={socialIcon(s.label)} /></a></li>
          ))}
        </ul>
      )}
    </div>

    {cols.map((c) => (
      <nav class="footer__col" aria-label={c.title} data-reveal>
        <p class="label">{c.title}</p>
        <ul class="footer__links">
          {c.links.map((l) => (
            <li><a href={url(l.href)} class="flink"><span class="flink__ico"><Icon name={l.icon} /></span><span class="flink__t">{l.label}</span><span class="arrow" aria-hidden="true">→</span></a></li>
          ))}
        </ul>
      </nav>
    ))}
  </div>

  <!-- Black bottom bar -->
  <div class="footer__bottom">
    <span>© {year} {site.name}. {site.location}.</span>
    <span class="footer__tag"><Icon name="heart" /> Good games. Great breaks.</span>
    <a href="#main" class="footer__top" data-to-top>
      <span class="footer__top-sq" aria-hidden="true"><Icon name="up" /></span>
      <span>Back to top</span>
    </a>
  </div>
</footer>

<style>
  /* Fixed colors (red panel, black ink) so the footer looks the same in light and dark mode */
  .footer { background: var(--red); color: var(--black); --ink: var(--black); --bg: var(--cream); --rule: 2px solid var(--black); container-type: inline-size; }

  /* Giant slogan: "Serious about fun." is about 7.1em wide in Anton, so this fills the footer edge to edge */
  .footer__mark { background: var(--bg-page); color: var(--ink-page); border-bottom: var(--rule); overflow: hidden; padding: 0 var(--gutter); }
  .footer__big { font-size: calc((100cqi - 2 * var(--gutter)) / 7.3); line-height: .9; margin: 0; padding: .17em 0 .16em; white-space: nowrap; text-align: center; letter-spacing: -.01em; color: var(--ink-page); }
  .fw { display: inline-block; overflow: hidden; vertical-align: top; padding: .12em 0 .26em; margin: -.12em 0 -.26em; }
  .fw > span:first-child { display: inline-block; }
  :global(.js) .footer__big[data-reveal] { opacity: 1; transform: none; }
  :global(.js) .fw > span:first-child { transform: translateY(135%); transition: transform .8s var(--ease-out); transition-delay: calc(var(--i) * 80ms + .05s); }
  :global(.js) .is-in .fw > span:first-child { transform: none; }

  /* Columns run edge to edge; the first and last line up with the page column */
  .footer__cols { --side: max(0px, (100cqi - var(--max)) / 2); display: grid; grid-template-columns: max(0px, (100% - var(--max)) / 2) 1.4fr repeat(2, 1fr) max(0px, (100% - var(--max)) / 2); border-bottom: var(--rule); }
  .footer__col { padding: clamp(32px, 4vw, 56px) clamp(20px, 2.5vw, 40px); display: flex; flex-direction: column; gap: 12px; position: relative; }
  .footer__col + .footer__col { border-left: var(--rule); }
  .footer__col:first-child { grid-column: 1 / 3; padding-left: calc(var(--side) + var(--gutter)); }
  .footer__col:last-child { grid-column: 4 / 6; padding-right: calc(var(--side) + var(--gutter)); }
  .footer__col .label { margin: 0 0 8px; font-size: 12px; display: inline-flex; align-items: center; gap: 10px; }
  .footer__col .label::before { content: ''; width: 10px; height: 10px; background: var(--black); transform: rotate(-14deg); }

  /* Brand block (yellow) */
  .footer__brand { overflow: hidden; }
  .footer__spark { width: 34px; height: 34px; right: 12%; top: 18%; transform: rotate(16deg); transition: transform .5s var(--ease-pop); }
  .footer__brand:hover .footer__spark { transform: rotate(106deg) scale(1.1); }
  .footer__logo { text-decoration: none; align-self: flex-start; margin-bottom: 6px; }
  .footer__line { display: inline-flex; align-items: center; gap: 10px; margin: 0; font-weight: 700; font-size: 16px; text-decoration: none; align-self: flex-start; }
  .footer__email { min-height: 44px; overflow-wrap: anywhere; }
  .footer__email:hover { text-decoration: underline; text-underline-offset: 4px; }
  .footer__social { list-style: none; margin: 8px 0 0; padding: 0; display: flex; flex-wrap: wrap; gap: 10px; }
  .footer__social a {
    display: grid; place-items: center; width: 48px; height: 48px; border: 2px solid var(--black); background: var(--cream); color: var(--black);
    transform: rotate(-6deg); transition: transform .35s var(--ease-pop), background .2s, color .2s, box-shadow .2s;
  }
  .footer__social li:nth-child(even) a { transform: rotate(5deg); }
  .footer__social a:hover, .footer__social a:focus-visible { background: var(--black); color: var(--cream); transform: rotate(0) translate(-3px, -3px); box-shadow: 4px 4px 0 var(--red); }

  /* Link rows: icon in a tilted cream box, label, arrow that slides in */
  .footer__links { list-style: none; margin: 0; padding: 0; display: flex; flex-direction: column; gap: 4px; }
  .flink { display: flex; align-items: center; gap: 14px; min-height: 48px; font-size: 17px; font-weight: 700; text-decoration: none; color: var(--black); }
  .flink__ico {
    flex: none; display: grid; place-items: center; width: 38px; height: 38px; border: 2px solid var(--black); background: var(--cream);
    transform: rotate(-8deg); transition: transform .35s var(--ease-pop), background .2s, color .2s;
  }
  .flink__ico :global(.icon) { width: 19px; height: 19px; }
  .flink__t { flex: 1; transition: transform .3s var(--ease-out); }
  .flink .arrow { font-family: var(--font-label); opacity: 0; transform: translateX(-8px); transition: transform .25s var(--ease-pop), opacity .2s; }
  .flink:hover .flink__ico, .flink:focus-visible .flink__ico { background: var(--black); color: var(--yellow); transform: rotate(0) scale(1.06); }
  .flink:hover .flink__t, .flink:focus-visible .flink__t { transform: translateX(4px); }
  .flink:hover .arrow, .flink:focus-visible .arrow { opacity: 1; transform: none; }

  /* Bottom bar: black in both modes */
  .footer__bottom {
    --side: max(0px, (100cqi - var(--max)) / 2); background: var(--black); color: var(--cream);
    display: flex; flex-wrap: wrap; align-items: center; justify-content: space-between; gap: 12px 28px;
    padding: 14px calc(var(--side) + var(--gutter)); font-size: 14px;
  }
  .footer__tag { display: inline-flex; align-items: center; gap: 8px; font-weight: 700; }
  .footer__tag :global(.icon) { color: var(--red); }
  .footer__top { display: inline-flex; align-items: center; gap: 12px; min-height: 48px; text-decoration: none; color: var(--cream); font-family: var(--font-label); font-size: 12px; letter-spacing: .08em; text-transform: uppercase; }
  .footer__top-sq { display: grid; place-items: center; width: 38px; height: 38px; background: var(--yellow); color: var(--black); transform: rotate(-12deg); transition: transform .4s var(--ease-pop), background .2s; }
  .footer__top:hover .footer__top-sq, .footer__top:focus-visible .footer__top-sq { transform: rotate(0) translateY(-5px); background: var(--red); }

  @media (max-width: 960px) {
    .footer__cols { grid-template-columns: 1fr 1fr; }
    .footer__col, .footer__col:first-child, .footer__col:last-child { padding: 32px var(--gutter); grid-column: auto; }
    .footer__col.footer__brand { grid-column: 1 / -1; }
    .footer__col + .footer__col { border-left: 0; border-top: var(--rule); }
    .footer__col:nth-child(3) { border-left: var(--rule); }
  }
  @media (max-width: 520px) {
    .footer__cols { grid-template-columns: 1fr; }
    .footer__col:nth-child(3) { border-left: 0; }
    .footer__bottom { flex-direction: column; align-items: flex-start; padding-block: 20px; }
  }

  @media (prefers-reduced-motion: reduce) {
    :global(.js) .fw > span:first-child { transform: none; transition: none; }
    .flink__ico, .flink__t, .flink .arrow, .footer__social a, .footer__top-sq, .footer__spark { transition: none; }
  }
</style>

<script>
  // Smooth back-to-top (the CSS scroll-behavior already respects reduced motion)
  document.querySelectorAll<HTMLAnchorElement>('[data-to-top]').forEach((a) => a.addEventListener('click', (e) => {
    e.preventDefault();
    window.scrollTo({ top: 0 });
    document.querySelector<HTMLElement>('#main')?.focus({ preventScroll: true });
  }));
</script>
