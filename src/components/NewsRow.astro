---
/** One post as a full-width row (news list and home page). Put it inside a list; it renders the <li>. */
import { url } from '../lib/url';
interface Post { slug: string; title: string; date: string; category: string; theme: string; excerpt: string; image?: string }
interface Props { post: Post; num: number }
const { post, num } = Astro.props;
const bg = ({ red: 'var(--red)', yellow: 'var(--yellow)', black: 'var(--black)' } as Record<string, string>)[post.theme] ?? 'var(--yellow)';
const sq = post.theme === 'red' ? 'yellow' : post.theme === 'black' ? 'red' : 'red';
const date = new Date(post.date + 'T12:00:00').toLocaleDateString('en-GB', { day: 'numeric', month: 'short', year: 'numeric' });
---
<li class="nrow-wrap" data-category={post.category} data-reveal>
  <a href={url(`/news/${post.slug}/`)} class="nrow">
    <span class="wrap nrow__inner">
      <span class="display nrow__num">{String(num).padStart(2, '0')}</span>
      <span class="nrow__meta">
        <span class="label">{post.category}</span>
        <time class="nrow__date" datetime={post.date}>{date}</time>
      </span>
      <span class="nrow__main">
        <span class="display nrow__title">{post.title}<span class="dot">.</span></span>
        <span class="nrow__ex">{post.excerpt}</span>
      </span>
      <span class="nrow__thumb" style={`background:${bg}`} aria-hidden="true">
        {post.image ? <img src={url(post.image)} alt="" loading="lazy" /> : <span class={`sq sq--${sq} nrow__sq`}></span>}
      </span>
      <span class="nrow__arrow" aria-hidden="true">→</span>
    </span>
  </a>
</li>

<style>
  .nrow-wrap { border-bottom: var(--rule); list-style: none; }
  .nrow-wrap[hidden] { display: none; }
  .nrow { display: block; text-decoration: none; color: var(--ink); position: relative; overflow: hidden; }
  /* Yellow fill wipes in from the left on hover */
  .nrow::before { content: ''; position: absolute; inset: 0; background: var(--yellow); transform: scaleX(0); transform-origin: left; transition: transform .55s var(--ease-out); }
  .nrow:hover, .nrow:focus-visible { color: var(--black); }
  .nrow:hover::before, .nrow:focus-visible::before { transform: scaleX(1); }
  .nrow__inner {
    position: relative; display: grid; align-items: center; gap: clamp(16px, 3vw, 40px);
    grid-template-columns: 90px 150px minmax(0, 1fr) clamp(140px, 18vw, 260px) 40px;
    padding-block: clamp(24px, 3vw, 36px);
  }
  .nrow__num { font-size: clamp(40px, 4vw, 64px); color: var(--red); line-height: 1; }
  .nrow__meta { display: flex; flex-direction: column; gap: 6px; }
  .nrow__meta .label { font-size: 12px; }
  .nrow__date { font-size: 15px; font-weight: 600; }
  .nrow__main { display: flex; flex-direction: column; gap: 8px; min-width: 0; }
  .nrow__title { font-size: clamp(34px, 4vw, 60px); line-height: 1; }
  .nrow__ex { font-size: 17px; max-width: 620px; }
  .nrow__thumb { position: relative; aspect-ratio: 16 / 10; border: 2px solid var(--black); overflow: hidden; transition: transform .45s var(--ease-pop); }
  .nrow:hover .nrow__thumb { transform: rotate(-3deg) scale(1.04); }
  .nrow__thumb img { width: 100%; height: 100%; object-fit: cover; }
  .nrow__sq { width: 42px; height: 42px; left: 20px; bottom: 18px; transform: rotate(14deg); transition: transform .5s var(--ease-pop); }
  .nrow:hover .nrow__sq { transform: rotate(104deg) translate(8px, -10px); }
  .nrow__arrow { font-family: var(--font-label); font-size: 28px; transition: transform .3s var(--ease-pop); }
  .nrow:hover .nrow__arrow { transform: translateX(8px); }

  @media (max-width: 960px) {
    .nrow__inner { grid-template-columns: 56px minmax(0, 1fr) 120px; grid-template-areas: 'num meta thumb' 'main main main'; }
    .nrow__num { grid-area: num; }
    .nrow__meta { grid-area: meta; }
    .nrow__thumb { grid-area: thumb; }
    .nrow__main { grid-area: main; }
    .nrow__arrow { display: none; }
  }

  @media (prefers-reduced-motion: reduce) {
    .nrow::before, .nrow__thumb, .nrow__sq, .nrow__arrow { transition: none; }
  }
</style>
