---
import { url } from '../lib/url';
interface Post { slug: string; title: string; date: string; category: string; theme: string; excerpt: string; image?: string }
interface Props { post: Post }
const { post } = Astro.props;
const bg = { red: 'var(--red)', yellow: 'var(--yellow)', black: 'var(--black)' }[post.theme] ?? 'var(--yellow)';
const sq = post.theme === 'black' ? 'yellow' : post.theme === 'red' ? 'black' : 'red';
const date = new Date(post.date + 'T12:00:00').toLocaleDateString('en-GB', { day: 'numeric', month: 'short', year: 'numeric' });
---
<a href={url(`/news/${post.slug}/`)} class="ncard" data-tilt>
  <div class="ncard__art" style={`background:${bg}`}>
    {post.image ? <img src={url(post.image)} alt="" loading="lazy" /> : <span class={`sq sq--${sq} ncard__sq`} aria-hidden="true"></span>}
  </div>
  <div class="ncard__body">
    <span class="label ncard__meta">{post.category} · <time datetime={post.date}>{date}</time></span>
    <h3 class="display ncard__title">{post.title}</h3>
    <p class="ncard__ex">{post.excerpt}</p>
  </div>
</a>

<style>
  .ncard { display: flex; flex-direction: column; height: 100%; text-decoration: none; color: var(--ink); border: var(--rule); background: var(--bg); transition: transform .3s var(--ease-out), box-shadow .3s var(--ease-out); }
  .ncard:hover { color: var(--ink); box-shadow: 8px 8px 0 var(--red); }
  .ncard__art { height: 190px; position: relative; overflow: hidden; border-bottom: var(--rule); }
  .ncard__art img { width: 100%; height: 100%; object-fit: cover; }
  .ncard__sq { width: 58px; height: 58px; left: 28px; bottom: 28px; transform: rotate(14deg); transition: transform .5s var(--ease-pop); }
  .ncard:hover .ncard__sq { transform: rotate(104deg) translate(10px, -14px); }
  .ncard__body { padding: 22px 24px 26px; display: flex; flex-direction: column; gap: 10px; }
  .ncard__meta { font-size: 11px; }
  .ncard__title { font-size: 30px; line-height: 1.05; }
  .ncard__ex { margin: 0; font-size: 16px; }
</style>
