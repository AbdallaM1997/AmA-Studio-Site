---
import Logo from './Logo.astro';
import site from '../data/site.json';

const path = Astro.url.pathname;
const isActive = (href: string) => !href.includes('#') && href !== '/' && path.startsWith(href);
---
<header class="nav">
  <nav class="nav__bar wrap" aria-label="Main">
    <a href="/" class="nav__logo" aria-label={`${site.name} home`}><Logo size="40px" /></a>

    <button class="nav__toggle" type="button" aria-expanded="false" aria-controls="nav-menu" aria-label="Open menu">
      <span></span><span></span><span></span>
    </button>

    <div class="nav__menu" id="nav-menu">
      <ul class="nav__links">
        {site.nav.map((item, i) => (
          <li>
            <a href={item.href} class:list={['nav__link', { 'is-active': isActive(item.href) }]}>
              <span class="nav__num">{String(i + 1).padStart(2, '0')}</span> {item.label}
            </a>
          </li>
        ))}
      </ul>
      <a href="/games/" class="btn btn--red btn--small">Play now</a>
    </div>
  </nav>
</header>

<style>
  .nav { border-bottom: var(--rule); background: var(--cream); position: sticky; top: 0; z-index: 50; }
  .nav__bar { display: flex; align-items: center; justify-content: space-between; gap: 20px; min-height: 76px; }
  .nav__logo { text-decoration: none; display: inline-flex; padding: 10px 0; }
  .nav__menu { display: flex; align-items: center; gap: 28px; }
  .nav__links { list-style: none; margin: 0; padding: 0; display: flex; gap: 26px; }
  .nav__link {
    font-family: var(--font-label); font-size: 13px; letter-spacing: .08em; text-transform: uppercase;
    text-decoration: none; display: inline-flex; gap: 6px; align-items: center; min-height: 44px; position: relative;
  }
  .nav__num { color: var(--red); }
  .nav__link::after {
    content: ''; position: absolute; left: 0; right: 0; bottom: 8px; height: 3px; background: var(--red);
    transform: scaleX(0); transform-origin: left; transition: transform .25s var(--ease-out);
  }
  .nav__link:hover::after, .nav__link.is-active::after { transform: scaleX(1); }

  .nav__toggle { display: none; width: 46px; height: 46px; border: var(--rule); background: var(--cream); cursor: pointer; padding: 0; flex-direction: column; align-items: center; justify-content: center; gap: 5px; }
  .nav__toggle span { width: 20px; height: 2.5px; background: var(--black); transition: transform .25s var(--ease-out), opacity .2s; }
  .nav__toggle[aria-expanded="true"] span:nth-child(1) { transform: translateY(7.5px) rotate(45deg); }
  .nav__toggle[aria-expanded="true"] span:nth-child(2) { opacity: 0; }
  .nav__toggle[aria-expanded="true"] span:nth-child(3) { transform: translateY(-7.5px) rotate(-45deg); }

  @media (max-width: 860px) {
    .nav__bar { min-height: 68px; }
    .nav__toggle { display: flex; }
    .nav__menu {
      position: absolute; top: 100%; left: 0; right: 0; background: var(--yellow); border-bottom: var(--rule);
      flex-direction: column; align-items: stretch; gap: 0; padding: 8px var(--gutter) 24px;
      clip-path: inset(0 0 100% 0); visibility: hidden; transition: clip-path .35s var(--ease-out), visibility 0s .35s;
    }
    .nav__menu.is-open { clip-path: inset(0 0 0 0); visibility: visible; transition: clip-path .35s var(--ease-out); }
    .nav__links { flex-direction: column; gap: 0; }
    .nav__link { font-family: var(--font-display); font-size: 40px; letter-spacing: 0; text-transform: none; min-height: 64px; border-bottom: var(--rule); width: 100%; gap: 14px; }
    .nav__link::after { display: none; }
    .nav__num { font-family: var(--font-label); font-size: 13px; }
    .nav__menu .btn { margin-top: 20px; min-height: 54px; }
  }
</style>
