---
/** A game card. `featured` makes it the big split card used on the home page. */
interface Game {
  slug: string; title: string; status: string; genre: string; theme: string; tagline: string;
  keyArt: string; stores: { appStore: string; googlePlay: string };
}
interface Props { game: Game; featured?: boolean }
const { game, featured = false } = Astro.props;

const statusLabel: Record<string, string> = { 'coming-soon': 'Coming soon', live: 'Out now', 'in-lab': 'In the lab' };
const artBg = { red: 'var(--red)', yellow: 'var(--yellow)', black: 'var(--black)' }[game.theme] ?? 'var(--red)';
---
<a href={`/games/${game.slug}/`} class:list={['gcard', { 'gcard--featured': featured }]} data-tilt>
  <div class="gcard__art ph" style={`background:${artBg}`}>
    {game.keyArt
      ? <img src={game.keyArt} alt={`${game.title} key art`} loading="lazy" />
      : <>
          <span class="sq sq--yellow gcard__s1" aria-hidden="true"></span>
          <span class="sq sq--black gcard__s2" aria-hidden="true"></span>
          <span class="ph__tag">Key art</span>
        </>}
  </div>
  <div class="gcard__body">
    <div class="gcard__top">
      <span class="label gcard__meta">{game.genre} · {statusLabel[game.status] ?? game.status}</span>
      <h3 class="display gcard__title">{game.title}<span class="dot">.</span></h3>
      <p class="gcard__tag">{game.tagline}</p>
    </div>
    <span class="textlink gcard__more">See the game <span class="arrow">→</span></span>
  </div>
</a>

<style>
  .gcard {
    display: flex; flex-direction: column; text-decoration: none; color: var(--black);
    background: var(--yellow); border: var(--rule); transition: transform .3s var(--ease-out), box-shadow .3s var(--ease-out);
  }
  .gcard:hover { color: var(--black); box-shadow: 8px 8px 0 var(--black); }
  .gcard--featured { flex-direction: row; flex-wrap: wrap; }
  .gcard__art { min-height: 260px; flex: 1 1 280px; }
  .gcard__art img { width: 100%; height: 100%; object-fit: cover; position: absolute; inset: 0; }
  .gcard--featured .gcard__art { min-height: 360px; }
  .gcard__s1 { width: 46px; height: 46px; left: 24px; top: 24px; transform: rotate(12deg); transition: transform .5s var(--ease-pop); }
  .gcard__s2 { width: 34px; height: 34px; right: 30px; bottom: 30px; transition: transform .5s var(--ease-pop); }
  .gcard:hover .gcard__s1 { transform: rotate(102deg) scale(1.15); }
  .gcard:hover .gcard__s2 { transform: rotate(-45deg) translate(-6px, -6px); }
  .gcard__body { flex: 1 1 300px; padding: 28px; display: flex; flex-direction: column; justify-content: space-between; gap: 20px; }
  .gcard__top { display: flex; flex-direction: column; gap: 12px; }
  .gcard__meta { font-size: 12px; }
  .gcard__title { font-size: clamp(48px, 5vw, 68px); }
  .gcard__tag { margin: 0; font-size: 18px; }
  .gcard:hover .gcard__more .arrow { transform: translateX(6px); }
</style>
