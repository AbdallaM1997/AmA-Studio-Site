---
import { url } from '../lib/url';
import '@fontsource/anton/400.css';
import '@fontsource/archivo-black/400.css';
import '@fontsource-variable/archivo/wdth.css';
import '../styles/global.css';
import Nav from '../components/Nav.astro';
import Footer from '../components/Footer.astro';
import Splash from '../components/Splash.astro';
import site from '../data/site.json';

interface Props { title?: string; description?: string; splash?: boolean }
const { title, description = site.description, splash = false } = Astro.props;
const fullTitle = title ? `${title} · ${site.name}` : `${site.name} — ${site.slogan}`;
const splashCfg = JSON.stringify({ on: splash && site.splash.enabled, variant: site.splash.variant, once: site.splash.oncePerSession });
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <meta name="theme-color" content="#F4473A" />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <link rel="icon" href={url('/favicon.svg')} type="image/svg+xml" />
    <!-- Pick light or dark before first paint: a saved choice, else the system setting -->
    <script is:inline>
      (function () {
        var t = null;
        try { t = localStorage.getItem('ama-theme'); } catch (e) {}
        if (t !== 'light' && t !== 'dark') t = matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light';
        document.documentElement.dataset.theme = t;
      })();
    </script>
    <!-- Decide before first paint whether the splash plays (no flash of content) -->
    <script is:inline define:vars={{ splashCfg }}>
      (function () {
        var d = document.documentElement, cfg = JSON.parse(splashCfg);
        d.classList.add('js');
        try {
          var q = new URLSearchParams(location.search).get('splash');
          var reduce = matchMedia('(prefers-reduced-motion: reduce)').matches;
          var seen = sessionStorage.getItem('ama-splash');
          var variants = ['pop', 'blocks', 'night'];
          if (q && variants.indexOf(q) > -1) { d.classList.add('splash-on'); d.dataset.splash = q; }
          else if (cfg.on && !reduce && !(cfg.once && seen)) { d.classList.add('splash-on'); d.dataset.splash = cfg.variant; }
        } catch (e) {}
      })();
    </script>
  </head>
  <body>
    <a class="skip-link" href="#main">Skip to content</a>
    <Splash />
    <Nav />
    <main id="main">
      <slot />
    </main>
    <Footer />
    <script>
      import { runSplash } from '../scripts/splash.js';
      import { runMotion } from '../scripts/motion.js';
      runMotion();
      runSplash();
    </script>
    <style is:global>
      .skip-link { position: absolute; left: 12px; top: -60px; z-index: 2000; background: var(--black); color: var(--cream); padding: 12px 16px; font-family: var(--font-label); font-size: 13px; }
      .skip-link:focus { top: 12px; }
      .toy-sq { position: absolute; pointer-events: none; z-index: 3; }
    </style>
  </body>
</html>
